# Entity: card

main: kit: entity: card: {

  alias: field: {}

  fields: [
    {
      name: "artist"
      req: false
      short: "The artist of the card"
      type: "`$STRING`"
    }
    {
      name: "border"
      req: false
      short: "The border color if different from the set default"
      type: "`$STRING`"
    }
    {
      name: "cmc"
      req: false
      short: "Converted mana cost"
      type: "`$NUMBER`"
    }
    {
      name: "colorIdentity"
      req: false
      short: "The card's color identity by color code"
      type: "`$ARRAY`"
    }
    {
      name: "colors"
      req: false
      short: "The card colors"
      type: "`$ARRAY`"
    }
    {
      name: "flavor"
      req: false
      short: "The flavor text of the card"
      type: "`$STRING`"
    }
    {
      name: "foreignNames"
      req: false
      short: "Foreign language names for the card"
      type: "`$ARRAY`"
    }
    {
      name: "hand"
      req: false
      short: "Maximum hand size modifier (Vanguard cards only)"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "A unique id for this card (SHA1 hash)"
      type: "`$STRING`"
    }
    {
      name: "imageUrl"
      req: false
      short: "The image URL for the card"
      type: "`$STRING`"
    }
    {
      name: "layout"
      req: false
      short: "The card layout"
      type: "`$STRING`"
    }
    {
      name: "legalities"
      req: false
      short: "Which formats this card is legal, restricted or banned in"
      type: "`$ARRAY`"
    }
    {
      name: "life"
      req: false
      short: "Starting life total modifier (Vanguard cards only)"
      type: "`$INTEGER`"
    }
    {
      name: "loyalty"
      req: false
      short: "The loyalty of the card (planeswalkers only)"
      type: "`$STRING`"
    }
    {
      name: "manaCost"
      req: false
      short: "The mana cost of the card"
      type: "`$STRING`"
    }
    {
      name: "multiverseid"
      req: false
      short: "The multiverseid of the card on Wizard's Gatherer"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The card name"
      type: "`$STRING`"
    }
    {
      name: "names"
      req: false
      short: "Only used for split, flip and dual cards."
      type: "`$ARRAY`"
    }
    {
      name: "number"
      req: false
      short: "The card number"
      type: "`$STRING`"
    }
    {
      name: "originalText"
      req: false
      short: "The original text on the card at the time it was printed"
      type: "`$STRING`"
    }
    {
      name: "originalType"
      req: false
      short: "The original type on the card at the time it was printed"
      type: "`$STRING`"
    }
    {
      name: "power"
      req: false
      short: "The power of the card (creatures only)"
      type: "`$STRING`"
    }
    {
      name: "printings"
      req: false
      short: "The sets that this card was printed in"
      type: "`$ARRAY`"
    }
    {
      name: "rarity"
      req: false
      short: "The rarity of the card"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "releaseDate"
      req: false
      short: "The release date for promo cards"
      type: "`$STRING`"
    }
    {
      name: "reserved"
      req: false
      short: "True if this card is reserved by Wizards Official Reprint Policy"
      type: "`$BOOLEAN`"
    }
    {
      name: "rulings"
      req: false
      short: "The rulings for the card"
      type: "`$ARRAY`"
    }
    {
      name: "set"
      req: false
      short: "The set code the card belongs to"
      type: "`$STRING`"
    }
    {
      name: "setName"
      req: false
      short: "The set name the card belongs to"
      type: "`$STRING`"
    }
    {
      name: "source"
      req: false
      short: "For promo cards, where the card was originally obtained"
      type: "`$STRING`"
    }
    {
      name: "starter"
      req: false
      short: "True if this card was only released as part of a core box set"
      type: "`$BOOLEAN`"
    }
    {
      name: "subtypes"
      req: false
      short: "The subtypes of the card"
      type: "`$ARRAY`"
    }
    {
      name: "supertypes"
      req: false
      short: "The supertypes of the card"
      type: "`$ARRAY`"
    }
    {
      name: "text"
      req: false
      short: "The oracle text of the card"
      type: "`$STRING`"
    }
    {
      name: "timeshifted"
      req: false
      short: "True if this card was timeshifted in the set"
      type: "`$BOOLEAN`"
    }
    {
      name: "toughness"
      req: false
      short: "The toughness of the card (creatures only)"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "The card type"
      type: "`$STRING`"
    }
    {
      name: "types"
      req: false
      short: "The types of the card"
      type: "`$ARRAY`"
    }
    {
      name: "variations"
      req: false
      short: "Multiverseids of alternate art variations"
      type: "`$ARRAY`"
    }
    {
      name: "watermark"
      req: false
      short: "The watermark on the card"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "card"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "artist"
                orig: "artist"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "cmc"
                orig: "cmc"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                kind: "query"
                name: "color"
                orig: "color"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "color_identity"
                orig: "color_identity"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "contain"
                orig: "contain"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "flavor"
                orig: "flavor"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "game_format"
                orig: "game_format"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "id"
                orig: "id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "language"
                orig: "language"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "layout"
                orig: "layout"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "legality"
                orig: "legality"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "loyalty"
                orig: "loyalty"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "multiverseid"
                orig: "multiverseid"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "number"
                orig: "number"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "order_by"
                orig: "order_by"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 100
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "power"
                orig: "power"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "random"
                orig: "random"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                kind: "query"
                name: "rarity"
                orig: "rarity"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "set"
                orig: "set"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "set_name"
                orig: "set_name"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "subtype"
                orig: "subtype"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "supertype"
                orig: "supertype"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "text"
                orig: "text"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "toughness"
                orig: "toughness"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cards"
          segments: [
            {
              lit: "cards"
            }
          ]
          select: {
            exist: [
              "artist"
              "cmc"
              "color"
              "color_identity"
              "contain"
              "flavor"
              "game_format"
              "id"
              "language"
              "layout"
              "legality"
              "loyalty"
              "multiverseid"
              "name"
              "number"
              "order_by"
              "page"
              "page_size"
              "power"
              "random"
              "rarity"
              "set"
              "set_name"
              "subtype"
              "supertype"
              "text"
              "toughness"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.cards`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cards/{id}"
          segments: [
            {
              lit: "cards"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.card`"
          }
        }
      ]
    }
  }



}
